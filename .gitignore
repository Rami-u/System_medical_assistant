# ═══════════════════════════════════════════════════════════
# Smart Medical System — .gitignore
# ═══════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual Environments ─────────────────────────────────
venv/
.venv/
env/
ENV/
gpu_env/
nutrtition/gpu_env/

# ── Environment / Secrets ────────────────────────────────
.env
.envrc

# ── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing / Coverage ──────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
*.cover
.tox/
.nox/

# ── Database Files ───────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite3

# ── ML Model Weights (large binary files) ────────────────
# These must be downloaded separately or trained locally.
# See nutrtition/README.md for training instructions.
models/*.pth
models/*.pkl
models/*.h5
models/*.onnx

# ── Nutrition Training Data (5+ GB) ─────────────────────
# Images downloaded from Nutrition5k dataset
nutrtition/images/
nutrtition/gpu_env/
nutrtition/__pycache__/

# Training artifacts / checkpoints
nutrtition/*.pth
nutrtition/*.pkl
nutrtition/*.csv
nutrtition/*.ipynb

# ── Notebooks (contain large outputs) ────────────────────
*.ipynb
!nutrtition/Nutrition5k_CNN_Training.ipynb

# ── AI/ML Artifacts & Datasets ───────────────────────────
Ai/artifacts/
Ai/processed/
Ai/SampleModel/
Ai/*.pkl

# ── Node.js / Frontend ──────────────────────────────────
node_modules/
Frontend_New/node_modules/

# ── Miscellaneous ────────────────────────────────────────
*.log
*.pid
*.rdb
*.aof
tempCodeRunnerFile.py
som3aa.csv
.ruff_cache/
.mypy_cache/
.dmypy.json
